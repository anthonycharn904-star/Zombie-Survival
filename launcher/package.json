{
  "name": "zombie-survival-launcher",
  "productName": "Zombie Survival",
  "version": "1.2.6",
  "description": "Launcher de Zombie Survival : mises à jour signées et lancement du jeu",
  "author": "Anthony",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "prepare-game": "node scripts/prepare-game.js",
    "start": "node scripts/prepare-game.js && electron .",
    "publier": "node scripts/prepare-game.js && electron . --publier",
    "modtools": "node scripts/prepare-game.js && electron . --modtools",
    "configure": "node scripts/configure.js",
    "test": "node --test",
    "test:e2e": "node scripts/prepare-game.js && node e2e/modtools.e2e.js && node e2e/game-menu.e2e.js && node e2e/publish-online.e2e.js && node e2e/stairs.e2e.js && node e2e/rank.e2e.js && node e2e/perk-drink.e2e.js && node e2e/outskirts.e2e.js",
    "dist:win": "node scripts/prepare-game.js && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.56.1"
  },
  "build": {
    "appId": "fr.zombiesurvival.launcher",
    "productName": "Zombie Survival",
    "copyright": "© 2026 Anthony",
    "compression": "maximum",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game-bundle"
      },
      {
        "from": "gamelibs",
        "to": "gamelibs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "artifactName": "Zombie-Survival-Setup-${version}.exe"
    }
  }
}
